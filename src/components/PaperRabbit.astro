---
interface Props { id: string; pose?: 'sitting' | 'lop' | 'sleepy'; }
const { id, pose = 'sitting' } = Astro.props;
---
<svg class:list={['paper-rabbit', `rabbit-${pose}`]} viewBox="0 0 260 310" fill="none" aria-hidden="true" focusable="false">
  <defs><filter id={`${id}-shadow`} x="-35%" y="-30%" width="180%" height="180%" color-interpolation-filters="sRGB"><feDropShadow dx="3" dy="6" stdDeviation="4" flood-color="#8b6070" flood-opacity=".18"/></filter></defs>
  <g class="rabbit-breathe" filter={`url(#${id}-shadow)`}>
    <circle cx="198" cy="243" r="24" fill="#f4eee7" stroke="#c9bcb6" stroke-width="1.2"/>
    <path d="M75 236C71 197 91 184 130 186C177 185 194 217 189 252C187 274 166 285 129 285C92 285 74 268 75 236Z" fill="#fffdf8" stroke="#c9bcb6" stroke-width="1.3"/>
    <path d="M155 219C168 229 171 252 156 265" stroke="#ddd1c9" stroke-width="1.2" stroke-linecap="round"/>
    <g class="rabbit-ear rabbit-ear-left">
      <path d="M99 137C88 117 76 65 83 37C87 17 100 14 109 33C124 64 120 113 117 138Z" fill="#fffdf8" stroke="#c9bcb6" stroke-width="1.3"/>
      <path d="M103 120C96 98 89 60 94 44C98 33 104 48 106 61C111 88 110 111 109 121Z" fill="#edc5ce"/>
      <path d="M87 54C85 76 91 104 97 120" stroke="#e2d8cf" stroke-width="1.5" stroke-linecap="round"/>
    </g>
    <g class="rabbit-ear rabbit-ear-right">
      {pose === 'lop' ? <>
        <path d="M140 135C141 97 153 63 175 61C197 59 211 87 208 114C206 132 195 139 186 127C177 115 184 93 174 92C165 93 167 121 164 144Z" fill="#fffdf8" stroke="#c9bcb6" stroke-width="1.3"/>
        <path d="M152 128C155 101 164 74 177 74C193 75 198 96 195 115C190 99 191 83 180 81C163 82 163 116 160 132Z" fill="#edc5ce"/>
      </> : <>
        <path d="M138 140C132 108 141 57 155 33C168 12 181 19 183 39C186 69 166 120 157 143Z" fill="#fffdf8" stroke="#c9bcb6" stroke-width="1.3"/>
        <path d="M147 122C145 101 152 65 163 47C169 37 175 40 173 54C169 80 157 110 153 125Z" fill="#edc5ce"/>
      </>}
    </g>
    <g class="rabbit-head">
      <path d="M76 163C75 130 99 111 128 112C162 110 184 132 181 165C180 194 159 209 128 209C97 209 76 193 76 163Z" fill="#fffefb" stroke="#c9bcb6" stroke-width="1.3"/>
      <path d="M83 150C88 132 102 125 112 125" stroke="#e0d4cc" stroke-width="1.3" stroke-linecap="round"/>
      <ellipse cx="100" cy="175" rx="11" ry="6" fill="#efcbd0" opacity=".7"/><ellipse cx="156" cy="175" rx="11" ry="6" fill="#efcbd0" opacity=".7"/>
      {pose === 'sleepy' ? <g stroke="#6e4b59" stroke-width="2" stroke-linecap="round"><path d="M103 159Q109 164 115 159"/><path d="M141 159Q147 164 153 159"/></g> : <g class="rabbit-blink" fill="#6e4b59"><ellipse cx="109" cy="159" rx="3.1" ry="4.1"/><ellipse cx="147" cy="159" rx="3.1" ry="4.1"/></g>}
      <path d="M124 173Q128 170 132 173L128 178Z" fill="#c78395"/>
      <path d="M128 178V182M128 182Q123 188 119 182M128 182Q133 188 137 182" stroke="#8c6673" stroke-width="1.25" stroke-linecap="round"/>
      <g stroke="#d1b8ba" stroke-width="1" stroke-linecap="round"><path d="M77 172 62 168M77 178 60 179M178 172 194 168M179 178 196 180"/></g>
    </g>
    <ellipse cx="99" cy="276" rx="27" ry="12" fill="#fffefb" stroke="#c9bcb6" stroke-width="1.2"/>
    <ellipse cx="159" cy="276" rx="27" ry="12" fill="#fffefb" stroke="#c9bcb6" stroke-width="1.2"/>
    <path d="M88 276V280M95 277V281M153 277V281M160 276V280" stroke="#e0d3cc" stroke-width="1.1" stroke-linecap="round"/>
    <ellipse cx="110" cy="225" rx="10" ry="21" transform="rotate(-17 110 225)" fill="#fffdf8" stroke="#d4c6bf" stroke-width="1.1"/>
  </g>
</svg>
