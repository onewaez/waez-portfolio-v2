---
import PaperRabbit from './PaperRabbit.astro';
---
<div class="rabbit-garden" data-scroll-scene="garden" role="img" aria-label="Four little white paper rabbits resting among flowers at the end of the page.">
  <div class="garden-caption"><span class="eyebrow">You've reached this little corner.</span><span>Thanks for wandering by.</span></div>
  <svg class="garden-backdrop" viewBox="0 0 1600 340" preserveAspectRatio="none" aria-hidden="true"><path d="M0 171C170 99 246 183 409 149C614 108 692 178 853 136C1049 84 1111 153 1275 122C1409 96 1508 113 1600 75V340H0Z" fill="#efbdce"/><path d="M0 217C170 177 266 224 397 195C574 156 726 243 911 185C1090 129 1169 205 1317 177C1450 152 1525 167 1600 151V340H0Z" fill="#f7d7df"/></svg>
  <div class="garden-rabbit garden-rabbit-one" data-garden-rabbit style="--rabbit-delay:-1s;--arrive-distance:65px"><div class="rabbit-hop"><PaperRabbit id="rabbit-left" pose="lop" /></div></div>
  <div class="garden-rabbit garden-rabbit-two" data-garden-rabbit style="--rabbit-delay:-3.5s;--arrive-distance:100px"><div class="rabbit-hop"><PaperRabbit id="rabbit-middle" /></div></div>
  <div class="garden-rabbit garden-rabbit-three" data-garden-rabbit style="--rabbit-delay:-5.4s;--arrive-distance:78px"><div class="rabbit-hop"><PaperRabbit id="rabbit-right" pose="sleepy" /></div></div>
  <div class="garden-rabbit garden-rabbit-four" data-garden-rabbit style="--rabbit-delay:-6.8s;--arrive-distance:48px"><div class="rabbit-hop"><PaperRabbit id="rabbit-small" /></div></div>
  <svg class="garden-flowers garden-flowers-left" viewBox="0 0 180 200" aria-hidden="true"><g class="flower-sway"><path d="M74 191Q100 129 76 66M72 178Q43 149 41 127M79 158Q112 137 119 119" fill="none" stroke="#9b7b75" stroke-width="1.6"/><path d="M73 152Q41 128 40 144Q47 162 73 164M81 142Q110 118 114 136Q102 153 81 155" fill="#d4b7b0"/><g fill="#fffaf5" stroke="#d7bbb8" stroke-width=".8"><ellipse cx="76" cy="47" rx="10" ry="19"/><ellipse cx="60" cy="60" rx="19" ry="10" transform="rotate(25 60 60)"/><ellipse cx="68" cy="77" rx="10" ry="18" transform="rotate(29 68 77)"/><ellipse cx="85" cy="77" rx="10" ry="18" transform="rotate(-29 85 77)"/><ellipse cx="92" cy="60" rx="19" ry="10" transform="rotate(-25 92 60)"/></g><circle cx="76" cy="63" r="8" fill="#dab1a8"/></g><path d="M130 193Q133 173 148 159M144 194Q149 183 157 181M26 194Q20 182 15 181" fill="none" stroke="#b8908a" stroke-width="1.2" stroke-linecap="round"/></svg>
  <svg class="garden-flowers garden-flowers-right" viewBox="0 0 180 200" aria-hidden="true"><g class="flower-sway"><path d="M83 190Q65 133 96 74M81 172Q111 145 123 140" fill="none" stroke="#9b7b75" stroke-width="1.6"/><path d="M80 150Q51 121 50 143Q58 160 81 161M82 173Q113 143 121 157Q108 174 82 181" fill="#d4b7b0"/><g fill="#fffaf5" stroke="#d7bbb8" stroke-width=".8"><ellipse cx="96" cy="54" rx="9" ry="17"/><ellipse cx="81" cy="67" rx="17" ry="9" transform="rotate(25 81 67)"/><ellipse cx="88" cy="82" rx="9" ry="17" transform="rotate(29 88 82)"/><ellipse cx="105" cy="82" rx="9" ry="17" transform="rotate(-29 105 82)"/><ellipse cx="111" cy="67" rx="17" ry="9" transform="rotate(-25 111 67)"/></g><circle cx="96" cy="69" r="7" fill="#dab1a8"/></g></svg>
  <svg class="garden-foreground" viewBox="0 0 1600 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0 57C172 28 279 84 443 62C615 40 697 81 838 63C1039 36 1173 96 1350 57C1466 32 1537 48 1600 40V140H0Z" fill="#fce9e9"/><path d="M0 76C218 41 297 104 482 82C653 62 734 110 912 82C1103 52 1213 119 1402 81C1494 62 1553 75 1600 72" fill="none" stroke="#dfbec0" stroke-width="1"/></svg>
</div>
